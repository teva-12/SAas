    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Platform</RootNamespace>
    <UserSecretsId>fashion-platform-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin exact versions and verify against the support matrix at kickoff (spec 11.4) -->
